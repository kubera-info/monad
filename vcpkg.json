{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "mysolution",
  "version-string": "1.0.0",
  "supports": "windows & (x64 | arm64)",
  "dependencies": [
    "7zip",
    {
      "name": "curl",
      "default-features": false,
      "features": [
        "brotli",
        "http3"
      ]
    },
    {
      "name": "directxtex",
      "features": [
        "dx12",
        "tools"
      ]
    },
    "meshoptimizer"
  ]
}
